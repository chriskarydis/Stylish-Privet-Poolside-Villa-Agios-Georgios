---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import { property } from '@content/property';
import type { LegalPage } from '@content/legal';
import type { Locale } from '@/i18n/config';
import { fill, localizePath, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';

interface Props {
  lang: Locale;
  page: LegalPage;
}
const { lang, page } = Astro.props;
const path = `/${page.slug}`;
const title = t(page.title, lang);
---

<BaseLayout lang={lang} path={path} title={`${title} | ${property.name}`} description={`${title} — ${property.name}`} noindex={!page.body}>
  <Header lang={lang} path={path} />
  <main id="main" tabindex="-1" class="legal section">
    <div class="container legal__inner">
      <h1>{title}</h1>
      {page.lastUpdated && <p class="legal__meta">{fill(t(ui.lastUpdated, lang), { date: page.lastUpdated })}</p>}
      {
        page.body ? (
          <div class="prose">{t(page.body, lang).map((p) => <p>{p}</p>)}</div>
        ) : (
          <p class="legal__pending">
            <Icon name="info" size={20} />
            <span>{t(ui.legalPending, lang)}</span>
          </p>
        )
      }
      <a class="text-link" href={localizePath('/', lang)}>
        <Icon name="chevron-left" size={18} />
        {t(ui.backHome, lang)}
      </a>
    </div>
  </main>
  <Footer lang={lang} path={path} />
</BaseLayout>

<style>
  .legal__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 50rem;
    min-height: 50vh;
  }
  .legal__meta {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .legal__pending {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-soft);
  }
  .legal__pending :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--sea);
  }
</style>
