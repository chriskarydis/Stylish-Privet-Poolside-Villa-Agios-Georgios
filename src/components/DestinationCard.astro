---
import type { Destination } from '@content/destinations';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import SmartImage from './ui/SmartImage.astro';
import Icon from './ui/Icon.astro';

interface Props {
  lang: Locale;
  destination: Destination;
  index: number;
}
const { lang, destination: d, index } = Astro.props;
---

<article class="dest" data-reveal style={`--reveal-delay:${index * 80}ms`}>
  <div class="frame dest__media">
    <SmartImage image={d.image} lang={lang} sizes="(min-width: 64em) 24vw, (min-width: 40em) 45vw, 80vw" compact />
    <span class="dest__kind">
      <Icon name={d.icon} size={15} />
      {t(d.kind, lang)}
    </span>
  </div>
  <h3 class="dest__name">{t(d.name, lang)}</h3>
  {d.distance && <p class="dest__distance">{t(d.distance, lang)}</p>}
  <p class="dest__text">{t(d.description, lang)}</p>
</article>

<style>
  .dest {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .dest__media {
    aspect-ratio: 4 / 5;
  }
  .dest__kind {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 252 247 / 0.94);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .dest__name {
    margin-top: 0.35rem;
    font-size: var(--fs-h4);
  }
  .dest__distance {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--terracotta);
  }
  .dest__text {
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
