---
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { fill, localizePath, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';

interface Props {
  lang: Locale;
  class?: string;
}
const { lang, class: className } = Astro.props;
---

<a href={localizePath('/', lang)} class:list={['logo', className]} aria-label={fill(t(ui.homeLink, lang), { name: property.name })}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1" />
    <circle cx="20" cy="15" r="5" fill="none" stroke="currentColor" stroke-width="1.2" />
    <path d="M8 25c2.5-1.6 5-1.6 7.5 0s5 1.6 7.5 0 5-1.6 7.5 0 3.5 1.2 3.5 1.2M8 29.5c2.5-1.6 5-1.6 7.5 0s5 1.6 7.5 0 5-1.6 7.5 0 3.5 1.2 3.5 1.2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  </svg>
  <span class="logo__text" aria-hidden="true">
    <span class="logo__name">Stylish Private <br />Poolside Villa</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    text-decoration: none;
    color: inherit;
  }
  .logo__mark {
    width: 38px;
    height: 38px;
    flex: none;
  }
  .logo__name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }
</style>
