---
import type { Locale } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';
import { nav, ui } from '@/i18n/ui';
import Logo from '@/components/layout/Logo.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import MobileMenu from '@/components/layout/MobileMenu.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
  path: string;
  /** Transparent over the hero until the page is scrolled. */
  overlay?: boolean;
}
const { lang, path, overlay = false } = Astro.props;
const home = localizePath('/', lang);
const links = nav.map((n) => ({ ...n, href: `${home}${n.href}`, text: t(n.label, lang) }));
---

<a class="skip-link" href="#main">{t(ui.skipToContent, lang)}</a>

<header class:list={['site-header', { 'is-overlay': overlay }]} data-header>
  <div class="site-header__inner container">
    <Logo lang={lang} class="site-header__logo" />

    <nav class="site-header__nav" aria-label={t(ui.mainNav, lang)}>
      <ul role="list">
        {
          links
            .filter((l) => l.id !== 'home' && l.primary !== false)
            .map((l) => (
              <li>
                <a href={l.href} data-nav-link={l.href.split('#')[1]}>
                  {l.text}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn site-header__book" href={`${home}#book`}>{t(ui.checkAvailability, lang)}</a>
      <LanguageSwitcher lang={lang} path={path} class="site-header__lang" />
      <button
        type="button"
        class="site-header__toggle"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <Icon name="menu" size={26} />
        <span class="visually-hidden">{t(ui.openMenu, lang)}</span>
      </button>
    </div>
  </div>
</header>

<MobileMenu lang={lang} path={path} links={links} />

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // Highlight the navigation item of the section in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = [...links]
    .map((l) => document.getElementById(l.dataset.navLink!))
    .filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => {
            const active = l.dataset.navLink === e.target.id;
            l.classList.toggle('is-active', active);
            if (active) l.setAttribute('aria-current', 'location');
            else l.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--linen);
    font-weight: 600;
    transform: translateY(-160%);
    transition: transform 0.2s var(--ease);
  }
  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    background: rgb(247 242 234 / 0.94);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: rgb(247 242 234 / 0.86);
      backdrop-filter: saturate(1.2) blur(10px);
    }
  }
  .site-header.is-scrolled {
    box-shadow: 0 6px 24px -18px rgb(38 34 29 / 0.5);
  }
  /* Over the hero: transparent with light text until scrolled. */
  .site-header.is-overlay {
    position: fixed;
    inset: 0 0 auto;
  }
  .site-header.is-overlay:not(.is-scrolled) {
    color: var(--on-dark);
    background: linear-gradient(to bottom, rgb(12 28 31 / 0.55), rgb(12 28 31 / 0));
    border-color: transparent;
    backdrop-filter: none;
  }
  .site-header.is-overlay:not(.is-scrolled) :focus-visible {
    outline-color: var(--linen);
  }
  .site-header.is-overlay:not(.is-scrolled) .site-header__book {
    --btn-bg: var(--linen);
    --btn-fg: var(--sea-deep);
    --btn-bd: var(--linen);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }
  .site-header__nav {
    display: none;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .site-header__book {
    display: none;
    min-height: 42px;
    padding: 0.55rem 1.1rem;
    font-size: 0.875rem;
  }
  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
  }
  .site-header__toggle:hover {
    background: rgb(127 127 127 / 0.12);
  }

  @media (max-width: 22.5em) {
    /* 320–360px: tighten the lockup */
    .site-header :global(.logo__mark) {
      display: none;
    }
  }
  @media (min-width: 40em) {
    .site-header__book {
      display: inline-flex;
      margin-right: 0.5rem;
    }
  }
  @media (min-width: 70em) {
    .site-header__nav {
      display: block;
      flex: 1;
    }
    .site-header__nav ul {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0 clamp(0.9rem, -1.4rem + 2.6vw, 1.75rem);
    }
    .site-header__nav a {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-size: 0.86rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-decoration: none;
      white-space: nowrap;
    }
    .site-header__nav a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 8px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s var(--ease);
    }
    .site-header__nav a:hover::after,
    .site-header__nav a.is-active::after {
      transform: scaleX(1);
    }
    .site-header__toggle {
      display: none;
    }
  }
</style>
