---
import { locales, localeMeta, type Locale } from '@/i18n/config';
import { fill, localizePath, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import Flag from '@/components/ui/Flag.astro';

interface Props {
  lang: Locale;
  /** Language-neutral path of the current page. */
  path: string;
  class?: string;
}
const { lang, path, class: className } = Astro.props;
---

<div class:list={['lang-switch', className]} role="group" aria-label={t(ui.language, lang)}>
  <ul role="list">
    {
      locales.map((l) => {
        const current = l === lang;
        const label = localeMeta[l].label;
        return (
          <li>
            <a
              href={localizePath(path, l)}
              hreflang={localeMeta[l].htmlLang}
              lang={localeMeta[l].htmlLang}
              class:list={['lang-switch__link', { 'is-current': current }]}
              aria-current={current ? 'true' : undefined}
              title={current ? label : fill(t(ui.switchTo, lang), { language: label })}
              data-lang-link
            >
              <Flag code={localeMeta[l].flag} />
              <span class="visually-hidden">{label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  // Keep the visitor at the same place when switching language. The two languages
  // have different text lengths, so the position is stored relative to the section
  // in view (section id + how far into it) rather than in pixels.
  const KEY = 'lang-switch-position';
  const headerOffset = () => document.querySelector<HTMLElement>('[data-header]')?.offsetHeight ?? 0;
  const sections = () => [...document.querySelectorAll<HTMLElement>('main section[id]')];

  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang-link]');
    if (!a || a.getAttribute('aria-current') === 'true') return;
    const line = window.scrollY + headerOffset() + 1;
    let current: { id: string; ratio: number } | null = null;
    for (const s of sections()) {
      const top = s.getBoundingClientRect().top + window.scrollY;
      if (top <= line && line < top + s.offsetHeight) current = { id: s.id, ratio: (line - top) / s.offsetHeight };
    }
    try {
      sessionStorage.setItem(KEY, JSON.stringify({ path: new URL(a.href).pathname, atTop: window.scrollY < 10, ...current }));
    } catch {
      /* storage unavailable — fall back to the top of the page */
    }
  });

  const restore = () => {
    let saved: { path: string; atTop: boolean; id?: string; ratio?: number } | null = null;
    try {
      saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
    } catch {
      return;
    }
    if (!saved || saved.path !== location.pathname || location.hash || saved.atTop || !saved.id) return;
    const s = document.getElementById(saved.id);
    if (!s) return;
    const top = s.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: top + (saved.ratio ?? 0) * s.offsetHeight - headerOffset() - 1, behavior: 'instant' });
  };
  // Restore now, and once more after web fonts load (they can change text heights slightly).
  restore();
  document.fonts?.ready.then(() => {
    restore();
    try {
      sessionStorage.removeItem(KEY);
    } catch {
      /* ignore */
    }
  });
</script>

<style>
  .lang-switch ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
  }
  .lang-switch__link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    opacity: 0.6;
    filter: saturate(0.7);
    transition:
      opacity 0.2s var(--ease),
      filter 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .lang-switch__link:hover {
    opacity: 1;
    filter: none;
    background: rgb(127 127 127 / 0.12);
  }
  .lang-switch__link.is-current {
    opacity: 1;
    filter: none;
    position: relative;
  }
  .lang-switch__link.is-current::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 7px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
</style>
