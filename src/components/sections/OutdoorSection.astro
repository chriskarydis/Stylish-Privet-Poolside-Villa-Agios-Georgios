---
import { home } from '@content/home';
import { outdoorFeatures } from '@content/amenities';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<section id="outdoors" class="section" aria-labelledby="outdoor-title">
  <div class="container">
    <div class="outdoor__grid">
      <div class="outdoor__text">
        <h2 id="outdoor-title">{t(home.outdoor.title, lang)}</h2>
        <div class="prose">
          {t(home.outdoor.body, lang).map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        </div>
        <ul role="list" class="icon-list outdoor__features">
          {
            outdoorFeatures.map((f) => (
              <li>
                <Icon name={f.icon} size={22} />
                <span>{t(f.label, lang)}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="outdoor__mosaic" data-reveal>
        <div class="frame m-a"><SmartImage image="garden" lang={lang} sizes="(min-width: 64em) 30vw, 92vw" /></div>
        <div class="frame m-b"><SmartImage image="outdoorDining" lang={lang} sizes="(min-width: 64em) 22vw, 46vw" compact /></div>
        <div class="frame m-c"><SmartImage image="balcony" lang={lang} sizes="(min-width: 64em) 22vw, 46vw" compact /></div>
      </div>
    </div>

    <aside class="views" aria-labelledby="views-title" data-reveal>
      <div class="views__icon"><Icon name="eye" size={28} /></div>
      <div class="views__body">
        <h3 id="views-title">{t(home.views.title, lang)}</h3>
        {t(home.views.body, lang).map((p, i) => <p class:list={{ 'views__note': i === 1 }}>{p}</p>)}
      </div>
    </aside>
  </div>
</section>

<style>
  .outdoor__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }
  .outdoor__text {
    display: grid;
    gap: 1.4rem;
  }
  .outdoor__features {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-weight: 500;
  }
  .outdoor__mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.9rem;
  }
  .m-a {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }
  .m-b,
  .m-c {
    aspect-ratio: 1;
  }
  @media (min-width: 64em) {
    .outdoor__grid {
      grid-template-columns: 1fr 1.1fr;
    }
    .outdoor__mosaic {
      grid-template-columns: 1.3fr 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .m-a {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      min-height: 30rem;
    }
    .m-b,
    .m-c {
      aspect-ratio: auto;
    }
  }

  .views {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--olive-tint);
  }
  .views__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--olive);
  }
  .views__body {
    display: grid;
    gap: 0.75rem;
    max-width: 64ch;
    color: var(--ink-soft);
  }
  .views__body h3 {
    color: var(--ink);
  }
  .views__note {
    font-weight: 600;
    color: var(--ink);
  }
  @media (min-width: 48em) {
    .views {
      grid-template-columns: auto 1fr;
      gap: 2rem;
    }
  }
</style>
