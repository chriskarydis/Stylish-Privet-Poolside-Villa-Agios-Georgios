---
/** Contact section: general enquiry form (Formspree, or email fallback) + direct contact details. */
import { home } from '@content/home';
import { legalPages } from '@content/legal';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const f = home.forms;
const c = home.contact;
const { contact } = property;
const privacyHref = localizePath(`/${legalPages.find((p) => p.slug === 'privacy-policy')!.slug}`, lang);
const [privacyBefore, privacyAfter] = t(f.privacy, lang).split('{link}');
const config = {
  formId: property.forms.generalFormId,
  email: contact.email,
  subject: t(f.subjectGeneral, lang),
  s: Object.fromEntries(Object.entries(f).map(([k, v]) => [k, t(v, lang)])),
};
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="eyebrow">{t(c.eyebrow, lang)}</p>
      <h2 id="contact-title">{t(c.heading, lang)}</h2>
      <p class="lead">{t(c.intro, lang)}</p>

      <h3 class="contact__direct-title">{t(c.directTitle, lang)}</h3>
      <ul role="list" class="contact__direct">
        {
          contact.phone && (
            <li>
              <a href={`tel:${contact.phone.replace(/\s+/g, '')}`}>
                <span class="contact__icon"><Icon name="phone" size={20} /></span>
                <span><small>{t(ui.phone, lang)}</small>{contact.phone}</span>
              </a>
            </li>
          )
        }
        {
          contact.whatsapp && (
            <li>
              <a href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(t(c.whatsappMessage, lang))}`} target="_blank" rel="noopener noreferrer">
                <span class="contact__icon"><Icon name="message-circle" size={20} /></span>
                <span>
                  <small>WhatsApp</small>
                  {
                    contact.whatsappName ? (
                      <>
                        {t(contact.whatsappName, lang)}
                        <span class="contact__sub">{contact.phone ?? `+${contact.whatsapp}`}</span>
                      </>
                    ) : (
                      (contact.phone ?? `+${contact.whatsapp}`)
                    )
                  }
                  <span class="visually-hidden"> {t(ui.opensInNewTab, lang)}</span>
                </span>
              </a>
            </li>
          )
        }
        {
          contact.email && (
            <li>
              <a href={`mailto:${contact.email}`}>
                <span class="contact__icon"><Icon name="mail" size={20} /></span>
                <span><small>{t(ui.email, lang)}</small>{contact.email}</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <form class="contact__form" data-contact-form novalidate>
      <script type="application/json" data-contact-config set:html={JSON.stringify(config)} />
      <div class="contact__row">
        <div class="field">
          <label for="cf-name">{t(f.name, lang)} <span aria-hidden="true">*</span></label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="cf-email">{t(f.email, lang)} <span aria-hidden="true">*</span></label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>
      <div class="field">
        <label for="cf-phone">{t(f.phone, lang)}</label>
        <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="cf-message">{t(f.message, lang)} <span aria-hidden="true">*</span></label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>
      <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="contact__fine">{privacyBefore}<a href={privacyHref}>{t(f.privacyLink, lang)}</a>{privacyAfter}</p>
      {!property.forms.generalFormId && <p class="contact__fine">{t(f.mailFallback, lang)}</p>}
      <button type="submit" class="btn" data-cf-submit>
        <Icon name="mail" size={18} />
        <span data-cf-label>{t(f.send, lang)}</span>
      </button>
      <p class="form-result" data-cf-result role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  import { formValues, isSpam, sendForm } from '@/lib/forms';

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const cfg = JSON.parse(form.querySelector('[data-contact-config]')!.textContent!) as {
      formId: string | null;
      email: string | null;
      subject: string;
      s: Record<string, string>;
    };
    const result = form.querySelector<HTMLElement>('[data-cf-result]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-cf-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-cf-label]')!;
    const show = (text: string, ok: boolean) => {
      result.textContent = text;
      result.classList.toggle('is-error', !ok);
      result.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.hidden = true;
      if (!form.checkValidity()) {
        const bad = form.querySelector<HTMLInputElement>(':invalid');
        show(bad?.type === 'email' && bad.value ? cfg.s.invalidEmail : cfg.s.fillRequired, false);
        bad?.focus();
        return;
      }
      if (isSpam(form)) return;
      const v = formValues(form);
      submit.disabled = true;
      label.textContent = cfg.s.sending;
      const res = await sendForm({
        formId: cfg.formId,
        fallbackEmail: cfg.email,
        subject: cfg.subject,
        data: { name: v.name, email: v.email, phone: v.phone, message: v.message, language: document.documentElement.lang },
        labels: { name: cfg.s.name, email: cfg.s.email, phone: cfg.s.phone, message: cfg.s.message },
      });
      submit.disabled = false;
      label.textContent = cfg.s.send;
      if (res === 'sent') {
        form.reset();
        show(cfg.s.success, true);
      } else if (res === 'error') show(cfg.s.error, false);
    });
  }
</script>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }
  .contact__intro {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .contact__direct-title {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact__direct {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    margin: 0;
  }
  .contact__direct a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    word-break: break-word;
    transition: border-color 0.2s var(--ease);
  }
  .contact__direct a:hover {
    border-color: var(--sea);
  }
  .contact__direct small {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact__sub {
    display: block;
    margin-top: 0.1rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--muted);
  }
  .contact__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--sea-tint);
    color: var(--sea);
  }
  .contact__form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .contact__row {
    display: grid;
    gap: 1rem;
  }
  .contact__fine {
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--muted);
  }
  .contact__fine a {
    color: var(--sea);
  }
  .contact__form .btn {
    justify-self: start;
  }
  @media (min-width: 40em) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64em) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
