---
/**
 * Booking section: copy + availability calendar (BookingWidget).
 * When a direct booking URL is configured in src/content/property.ts
 * (booking.directUrl) it is shown as the primary button above the calendar.
 */
import { home } from '@content/home';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { fill, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';
import BookingWidget from '@/components/booking/BookingWidget.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { booking } = property;
---

<section id="book" class="book on-dark" aria-labelledby="book-title">
  <div class="book__bg" aria-hidden="true">
    <SmartImage image="agiosGeorgios" lang={lang} sizes="100vw" compact />
  </div>
  <div class="container book__grid">
    <div class="book__text" data-reveal>
      <h2 id="book-title">{t(home.booking.title, lang)}</h2>
      <div class="book__copy">
        {t(home.booking.body, lang).map((p) => <p>{p}</p>)}
      </div>
      <ul role="list" class="book__facts">
        <li><Icon name="clock" size={18} />{fill(t(ui.checkIn, lang), { time: property.rules.checkIn })}</li>
        <li><Icon name="clock" size={18} />{fill(t(ui.checkOut, lang), { time: property.rules.checkOut })}</li>
        <li><Icon name="users" size={18} />{fill(t(ui.guests, lang), { n: property.facts.maxGuests })}</li>
      </ul>
      {
        booking.directUrl && (
          <a class="btn btn--light" href={booking.directUrl}>
            {t(home.booking.cta, lang)}
            <Icon name="arrow-right" size={18} />
          </a>
        )
      }
      <p class="book__note">{t(home.booking.platformsNote, lang)}</p>
      <a class="btn btn--ghost-light book__contact" href="#contact">
        <Icon name="message-circle" size={18} />
        {t(home.booking.secondary, lang)}
      </a>
    </div>

    <div class="book__widget">
      <BookingWidget lang={lang} />
    </div>
  </div>
</section>

<style>
  .book {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-y);
    background: var(--sea-deep);
    color: var(--on-dark);
    overflow: hidden;
  }
  .book__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
  }
  .book__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgb(20 58 64 / 0.92), rgb(20 58 64 / 0.6));
  }
  .book__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    align-items: start;
  }
  .book__text {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .book__copy {
    display: grid;
    gap: 0.9rem;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--on-dark-muted);
  }
  .book__facts {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-weight: 600;
  }
  .book__facts li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .book__facts :global(.icon) {
    color: #efc9a6;
  }
  .book__note {
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
  }
  @media (min-width: 64em) {
    .book__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .book__text {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
