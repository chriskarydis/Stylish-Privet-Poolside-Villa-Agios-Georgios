---
/**
 * Booking call-to-action. No live availability is shown: visitors are sent to
 * the official listings. When a direct booking/enquiry URL is configured in
 * src/content/property.ts (booking.directUrl) it becomes the primary button.
 */
import { home } from '@content/home';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { fill, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { booking } = property;
const newTab = t(ui.opensInNewTab, lang);
const platforms = [
  { name: 'Airbnb', href: booking.airbnb[lang] },
  { name: 'Booking.com', href: booking.bookingCom[lang] },
];
---

<section id="book" class="book on-dark" aria-labelledby="book-title">
  <div class="book__bg" aria-hidden="true">
    <SmartImage image="agiosGeorgios" lang={lang} sizes="100vw" compact />
  </div>
  <div class="container book__inner">
    <div class="book__card" data-reveal>
      <h2 id="book-title">{t(home.booking.title, lang)}</h2>
      <div class="book__copy">
        {t(home.booking.body, lang).map((p) => <p>{p}</p>)}
      </div>

      <div class="book__actions">
        {
          booking.directUrl ? (
            <a class="btn btn--light" href={booking.directUrl}>
              {t(home.booking.cta, lang)}
              <Icon name="arrow-right" size={18} />
            </a>
          ) : (
            <div class="book__choose" role="group" aria-labelledby="book-cta-label">
              <p id="book-cta-label" class="book__cta-label">
                <Icon name="check" size={18} />
                {t(home.booking.cta, lang)}
              </p>
              <div class="book__platforms">
                {platforms.map((p) => (
                  <a class="btn btn--light book__platform" href={p.href} target="_blank" rel="noopener noreferrer">
                    <span class="visually-hidden">{fill(t(ui.checkOn, lang), { platform: '' }).trim()} </span>
                    {p.name}
                    <span class="visually-hidden"> {newTab}</span>
                    <Icon name="external-link" size={16} />
                  </a>
                ))}
              </div>
            </div>
          )
        }
        <a class="btn btn--ghost-light" href="#contact">
          <Icon name="message-circle" size={18} />
          {t(home.booking.secondary, lang)}
        </a>
      </div>

      <p class="book__note">{t(home.booking.platformsNote, lang)}</p>
    </div>
  </div>
</section>

<style>
  .book {
    position: relative;
    isolation: isolate;
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
    background: var(--sea-deep);
    color: var(--on-dark);
    overflow: hidden;
  }
  .book__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
  }
  .book__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgb(20 58 64 / 0.9), rgb(20 58 64 / 0.55));
  }
  .book__bg :global(.smart-ph) {
    filter: saturate(0.6);
  }
  .book__inner {
    display: grid;
  }
  .book__card {
    display: grid;
    gap: 1.5rem;
    max-width: 46rem;
  }
  .book__copy {
    display: grid;
    gap: 0.9rem;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--on-dark-muted);
  }
  .book__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.25rem;
    margin-top: 0.75rem;
  }
  .book__choose {
    display: grid;
    gap: 0.75rem;
  }
  .book__cta-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #efc9a6;
  }
  .book__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .book__platform {
    min-width: 10.5rem;
  }
  .book__note {
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
  }
  @media (max-width: 30em) {
    .book__actions,
    .book__platforms {
      display: grid;
      width: 100%;
    }
  }
</style>
