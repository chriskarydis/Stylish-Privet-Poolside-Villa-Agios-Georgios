---
import { home } from '@content/home';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';
import BeachRoute from '@/components/ui/BeachRoute.astro';
import VillaMap from '@/components/ui/VillaMap.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const loc = property.location;
---

<section id="location" class="section section--surface" aria-labelledby="location-title">
  <div class="container loc__grid">
    <div class="loc__media" data-reveal>
      <div class="frame loc__frame">
        <SmartImage image="beach" lang={lang} sizes="(min-width: 64em) 48vw, 92vw" />
      </div>
      <div class="loc__stat">
        <span class="loc__stat-value serif">{property.facts.beachDistanceM}<small> m</small></span>
        <span class="loc__stat-label">{t(home.location.highlight, lang)}</span>
      </div>
    </div>

    <div class="loc__text">
      <p class="eyebrow">{t(home.location.eyebrow, lang)}</p>
      <h2 id="location-title">{t(home.location.title, lang)}</h2>
      <p class="loc__address">
        <Icon name="map-pin" size={18} />
        <span>
          {loc.streetAddress && <>{t(loc.streetAddress, lang)}, </>}
          {t(loc.locality, lang)}, {t(loc.region, lang)}, {t(loc.country, lang)}
        </span>
      </p>
      <div class="prose">
        {t(home.location.body, lang).map((p) => <p>{p}</p>)}
      </div>

      <div class="loc__ideal">
        <h3 class="loc__ideal-title">{t(home.location.idealFor, lang)}</h3>
        <ul role="list">
          {t(home.location.idealList, lang).map((item) => <li>{item}</li>)}
        </ul>
      </div>

      {
        /* Area-level link, shown only until the villa's own pin exists (see VillaMap below). */
        !loc.coordinates && (
          <div class="loc__map">
            <a class="text-link" href={loc.areaMapUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="map-pin" size={18} />
              {t(home.location.mapLink, lang)}
              <span class="visually-hidden"> {t(ui.opensInNewTab, lang)}</span>
              <Icon name="external-link" size={14} />
            </a>
            <p class="loc__map-note">{t(home.location.mapNote, lang)}</p>
          </div>
        )
      }
    </div>
  </div>
  <div class="container loc__route">
    <BeachRoute lang={lang} />
    <VillaMap lang={lang} />
  </div>
</section>

<style>
  .loc__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }
  .loc__media {
    position: relative;
    padding-bottom: 2.5rem;
  }
  .loc__frame {
    aspect-ratio: 4 / 3;
  }
  .loc__stat {
    position: absolute;
    left: clamp(1rem, 4%, 2rem);
    bottom: 0;
    display: grid;
    padding: 1.25rem 1.6rem;
    border-radius: var(--radius);
    background: var(--sea);
    color: var(--on-dark);
    box-shadow: var(--shadow);
  }
  .loc__stat-value {
    font-size: clamp(2.6rem, 2rem + 2.4vw, 3.6rem);
    line-height: 1;
  }
  .loc__stat-value small {
    font-size: 0.5em;
  }
  .loc__stat-label {
    margin-top: 0.3rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .loc__text {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }
  .loc__address {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .loc__address :global(.icon) {
    flex: none;
    color: var(--terracotta);
  }
  .loc__ideal {
    width: 100%;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .loc__ideal-title {
    margin-bottom: 0.8rem;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .loc__ideal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .loc__ideal li {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 500;
    background: var(--linen);
  }
  .loc__route {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }
  .loc__map-note {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  @media (min-width: 64em) {
    .loc__grid {
      grid-template-columns: 1fr 1fr;
    }
    .loc__frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>
