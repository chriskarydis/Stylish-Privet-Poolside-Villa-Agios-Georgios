---
import { getImage } from 'astro:assets';
import { galleryCategories, galleryItems } from '@content/gallery';
import { home } from '@content/home';
import type { Locale } from '@/i18n/config';
import { fill, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import { findImage, resolveSlot } from '@/lib/images';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const items = await Promise.all(
  galleryItems.map(async (item, index) => {
    const slot = resolveSlot(item.image);
    const src = findImage(item.image);
    // Large, optimised version for the lightbox (generated at build time).
    let full: { src: string; srcset: string; width: number; height: number } | null = null;
    if (src) {
      const widths = [960, 1440, 2048].filter((w) => w <= src.width);
      const img = await getImage({ src, widths: widths.length ? widths : [src.width], format: 'webp' });
      full = { src: img.src, srcset: img.srcSet.attribute, width: src.width, height: src.height };
    }
    // Layout rhythm: portrait photos span two rows; some landscapes span two columns.
    const shape = src ? (src.height > src.width * 1.1 ? 'tall' : index % 5 === 0 ? 'wide' : 'std') : ['wide', 'std', 'tall', 'std', 'std', 'tall'][index % 6];
    return { index, category: item.category, slot, image: item.image, full, shape };
  }),
);

const categories = galleryCategories.filter((c) => items.some((i) => i.category === c.id));

const lightboxData = items.map((i) => ({
  category: i.category,
  label: t(i.slot.label, lang),
  alt: t(i.slot.alt, lang),
  tone: i.slot.tone,
  full: i.full,
}));

const strings = {
  counter: t(ui.counter, lang),
  showing: lang === 'el' ? '{n} φωτογραφίες' : '{n} photos',
  soon: t(ui.photoComingSoon, lang),
};
---

<section id="gallery" class="section" aria-labelledby="gallery-title" data-gallery>
  <div class="container">
    <div class="gallery__head">
      <div class="section-head">
        <p class="eyebrow">{t(home.gallery.eyebrow, lang)}</p>
        <h2 id="gallery-title">{t(home.gallery.title, lang)}</h2>
      </div>

      <div class="gallery__filters" role="group" aria-label={t(ui.galleryFilter, lang)}>
        <button type="button" class="chip" aria-pressed="true" data-filter="all">{t(ui.all, lang)}</button>
        {
          categories.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c.id}>
              {t(c.label, lang)}
            </button>
          ))
        }
      </div>
    </div>
    <p class="visually-hidden" aria-live="polite" data-gallery-status></p>

    <ul role="list" class="gallery__grid">
      {
        items.map((i) => (
          <li class:list={['gallery__item', `is-${i.shape}`]} data-category={i.category}>
            <button
              type="button"
              class="gallery__btn"
              data-index={i.index}
              aria-label={fill(t(ui.openPhoto, lang), { label: t(i.slot.label, lang) })}
            >
              <SmartImage image={i.image} lang={lang} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 50vw" widths={[360, 540, 720, 1080]} compact />
              <span class="gallery__caption" aria-hidden="true">
                <span>{t(i.slot.label, lang)}</span>
                <Icon name="expand" size={16} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label={t(ui.lightbox, lang)} data-lightbox>
    <div class="lightbox__bar">
      <p class="lightbox__counter" data-lb-counter></p>
      <button type="button" class="lightbox__icon-btn" data-lb-close>
        <Icon name="x" size={26} />
        <span class="visually-hidden">{t(ui.close, lang)}</span>
      </button>
    </div>
    <figure class="lightbox__figure">
      <div class="lightbox__stage" data-lb-stage></div>
      <figcaption class="lightbox__caption" data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__icon-btn lightbox__nav lightbox__nav--prev" data-lb-prev>
      <Icon name="chevron-left" size={30} />
      <span class="visually-hidden">{t(ui.previous, lang)}</span>
    </button>
    <button type="button" class="lightbox__icon-btn lightbox__nav lightbox__nav--next" data-lb-next>
      <Icon name="chevron-right" size={30} />
      <span class="visually-hidden">{t(ui.next, lang)}</span>
    </button>
  </dialog>

  <script type="application/json" data-gallery-data set:html={JSON.stringify({ items: lightboxData, strings })} />
</section>

<script>
  type Item = {
    category: string;
    label: string;
    alt: string;
    tone: string;
    full: { src: string; srcset: string; width: number; height: number } | null;
  };

  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const dataEl = root?.querySelector('[data-gallery-data]');
  const dialog = root?.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (root && dataEl && dialog) {
    const { items, strings } = JSON.parse(dataEl.textContent || '{}') as {
      items: Item[];
      strings: { counter: string; showing: string; soon: string };
    };
    const tiles = [...root.querySelectorAll<HTMLLIElement>('.gallery__item')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const status = root.querySelector<HTMLElement>('[data-gallery-status]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    let visible: number[] = items.map((_, i) => i);
    let pos = 0;
    let opener: HTMLElement | null = null;

    const fmt = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));

    // ----- Filters -----
    filters.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        visible = [];
        tiles.forEach((tile, i) => {
          const show = f === 'all' || tile.dataset.category === f;
          tile.hidden = !show;
          if (show) visible.push(i);
        });
        status.textContent = fmt(strings.showing, { n: visible.length });
      }),
    );

    // ----- Lightbox -----
    const render = () => {
      const item = items[visible[pos]];
      stage.replaceChildren();
      if (item.full) {
        const img = document.createElement('img');
        img.src = item.full.src;
        img.srcset = item.full.srcset;
        img.sizes = '100vw';
        img.alt = item.alt;
        img.width = item.full.width;
        img.height = item.full.height;
        img.decoding = 'async';
        stage.append(img);
      } else {
        const ph = document.createElement('div');
        ph.className = `lightbox__ph tone-${item.tone}`;
        ph.setAttribute('role', 'img');
        ph.setAttribute('aria-label', item.alt);
        const name = document.createElement('span');
        const soon = document.createElement('small');
        name.textContent = item.label;
        soon.textContent = strings.soon;
        ph.append(name, soon);
        stage.append(ph);
      }
      caption.textContent = item.label;
      counter.textContent = fmt(strings.counter, { i: pos + 1, n: visible.length });
      // Preload neighbours for instant navigation.
      [pos - 1, pos + 1].forEach((p) => {
        const n = items[visible[(p + visible.length) % visible.length]];
        if (n?.full) {
          const pre = new Image();
          pre.sizes = '100vw';
          pre.srcset = n.full.srcset;
        }
      });
    };
    const go = (delta: number) => {
      pos = (pos + delta + visible.length) % visible.length;
      render();
    };

    root.querySelectorAll<HTMLButtonElement>('.gallery__btn').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        pos = Math.max(0, visible.indexOf(Number(btn.dataset.index)));
        render();
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => go(-1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => go(1));
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'Home') { pos = 0; render(); }
      else if (e.key === 'End') { pos = visible.length - 1; render(); }
      else return;
      e.preventDefault();
    });

    // Touch swipe
    let startX = 0;
    let startY = 0;
    stage.addEventListener('pointerdown', (e) => { startX = e.clientX; startY = e.clientY; });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) go(dx < 0 ? 1 : -1);
    });
  }
</script>

<style>
  .gallery__head {
    display: grid;
    gap: 0.5rem;
    align-items: end;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .gallery__head .section-head {
    margin-bottom: 0;
  }
  .gallery__filters {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.5rem var(--gutter);
    scrollbar-width: none;
  }
  .gallery__filters::-webkit-scrollbar {
    display: none;
  }
  .chip {
    flex: none;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--stone);
    border-radius: 999px;
    background: transparent;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--linen);
  }
  @media (min-width: 64em) {
    .gallery__head {
      grid-template-columns: 1fr auto;
      gap: 2rem;
    }
    .gallery__filters {
      flex-wrap: wrap;
      justify-content: flex-end;
      max-width: 40rem;
      margin: 0;
      padding: 0;
    }
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(9rem, 22vw, 13rem);
    grid-auto-flow: dense;
    gap: 0.6rem;
    margin: 0;
  }
  @media (min-width: 40em) {
    .gallery__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.8rem;
    }
  }
  @media (min-width: 64em) {
    .gallery__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(11rem, 15vw, 15rem);
      gap: 1rem;
    }
  }
  .gallery__item.is-wide {
    grid-column: span 2;
  }
  .gallery__item.is-tall {
    grid-row: span 2;
  }
  .gallery__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand);
    cursor: zoom-in;
  }
  .gallery__btn :global(img),
  .gallery__btn :global(.smart-ph) {
    transition: transform 0.8s var(--ease);
  }
  .gallery__btn:hover :global(img),
  .gallery__btn:hover :global(.smart-ph) {
    transform: scale(1.035);
  }
  .gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 2rem 0.9rem 0.75rem;
    background: linear-gradient(to top, rgb(12 24 26 / 0.7), transparent);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-align: left;
  }

  /* ----- Lightbox ----- */
  .lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(14 20 21 / 0.97);
    color: var(--on-dark);
    display: none;
    grid-template-rows: auto 1fr;
  }
  .lightbox[open] {
    display: grid;
  }
  .lightbox::backdrop {
    background: rgb(14 20 21 / 0.9);
  }
  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }
  .lightbox :focus-visible {
    outline-color: var(--linen);
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: max(0.5rem, env(safe-area-inset-top)) var(--gutter) 0.5rem;
  }
  .lightbox__counter {
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--on-dark-muted);
  }
  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0;
    padding: 0 var(--gutter) max(1rem, env(safe-area-inset-bottom));
  }
  .lightbox__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    touch-action: pan-y;
  }
  .lightbox__stage :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .lightbox__stage :global(.lightbox__ph) {
    display: grid;
    place-content: center;
    gap: 0.4rem;
    width: min(100%, 70rem);
    aspect-ratio: 3 / 2;
    max-height: 100%;
    border-radius: var(--radius-sm);
    background: var(--ph-bg);
    color: var(--ph-fg);
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1.6rem;
  }
  .lightbox__stage :global(.lightbox__ph small) {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lightbox__caption {
    padding-top: 0.9rem;
    text-align: center;
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
  }
  .lightbox__icon-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--on-dark);
    transition: background-color 0.2s var(--ease);
  }
  .lightbox__icon-btn:hover {
    background: rgb(255 255 255 / 0.18);
  }
  .lightbox__nav {
    position: fixed;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__nav--prev {
    left: max(0.5rem, env(safe-area-inset-left));
  }
  .lightbox__nav--next {
    right: max(0.5rem, env(safe-area-inset-right));
  }
  @media (max-width: 40em) {
    .lightbox__nav {
      top: auto;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      translate: none;
    }
    .lightbox__figure {
      padding-bottom: 5rem;
    }
  }
</style>
