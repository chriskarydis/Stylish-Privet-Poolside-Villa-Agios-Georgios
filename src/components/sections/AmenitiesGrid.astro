---
import { amenityCategories } from '@content/amenities';
import { home } from '@content/home';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { fill, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { rules } = property;

const houseRules: { icon: IconName; text: string; ok: boolean }[] = [
  { icon: 'clock', text: fill(t(ui.checkIn, lang), { time: rules.checkIn }), ok: true },
  { icon: 'clock', text: fill(t(ui.checkOut, lang), { time: rules.checkOut }), ok: true },
  ...(rules.children ? [{ icon: 'baby' as const, text: t(ui.childrenWelcome, lang), ok: true }] : []),
  ...(!rules.childrenInPool ? [{ icon: 'pool' as const, text: t(ui.noChildrenInPool, lang), ok: false }] : []),
  ...(!rules.pets ? [{ icon: 'paw-print' as const, text: t(ui.noPets, lang), ok: false }] : []),
  ...(!rules.smokingInside ? [{ icon: 'cigarette-off' as const, text: t(ui.noSmoking, lang), ok: false }] : []),
  ...(!rules.parties ? [{ icon: 'party-popper' as const, text: t(ui.noParties, lang), ok: false }] : []),
];
---

<section id="amenities" class="section section--tint" aria-labelledby="amenities-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t(home.amenities.eyebrow, lang)}</p>
      <h2 id="amenities-title">{t(home.amenities.title, lang)}</h2>
    </div>

    <div class="amen-grid">
      {
        amenityCategories.map((cat, i) => (
          <section class:list={['amen-card', `amen-card--${cat.id}`]} aria-labelledby={`amen-${cat.id}`} data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <header class="amen-card__head">
              <Icon name={cat.icon} size={24} />
              <h3 id={`amen-${cat.id}`}>{t(cat.title, lang)}</h3>
            </header>
            <ul role="list" class="icon-list">
              {cat.items.map((item) => (
                <li>
                  <Icon name={item.icon} size={20} />
                  <span>{t(item.label, lang)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="amen-extra">
      <section class="amen-extra__block" aria-labelledby="rules-title">
        <h3 id="rules-title">{t(home.amenities.rulesTitle, lang)}</h3>
        <ul role="list" class="rules">
          {
            houseRules.map((r) => (
              <li class:list={{ 'is-no': !r.ok }}>
                <Icon name={r.icon} size={20} />
                <span>{r.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="amen-extra__block" aria-labelledby="services-title">
        <h3 id="services-title">{t(home.amenities.servicesTitle, lang)}</h3>
        <ul role="list" class="icon-list">
          {
            property.additionalServices.map((s) => (
              <li>
                <Icon name={s.icon} size={20} />
                <span>{t(s.label, lang)}</span>
              </li>
            ))
          }
        </ul>
        <p class="amen-extra__note">
          <Icon name="info" size={16} />
          <span>{t(home.amenities.servicesNote, lang)}</span>
        </p>
      </section>
    </div>
  </div>
</section>

<style>
  .amen-grid {
    display: grid;
    gap: 1rem;
  }
  .amen-card {
    padding: 1.6rem 1.5rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .amen-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    color: var(--terracotta);
  }
  .amen-card__head h3 {
    font-size: 1.5rem;
    color: var(--ink);
  }
  .amen-card .icon-list li {
    font-size: 0.97rem;
  }
  @media (min-width: 40em) {
    .amen-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .amen-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    /* Row 1: the three long lists. Row 2: the two short ones. */
    .amen-card--comfort,
    .amen-card--kitchen,
    .amen-card--outdoor {
      grid-column: span 2;
    }
    .amen-card--entertainment,
    .amen-card--parking {
      grid-column: span 3;
      order: 1;
    }
  }

  .amen-extra {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .amen-extra__block {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .amen-extra__block h3 {
    font-size: 1.5rem;
  }
  .rules {
    display: grid;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }
  .rules li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.5rem;
    line-height: 1.4;
  }
  .rules :global(.icon) {
    flex: none;
    color: var(--sea);
  }
  .rules .is-no :global(.icon) {
    color: var(--terracotta);
  }
  .amen-extra__note {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--muted);
  }
  .amen-extra__note :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
  }
  @media (min-width: 40em) {
    .rules {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64em) {
    .amen-extra {
      grid-template-columns: 1.6fr 1fr;
    }
  }
</style>
