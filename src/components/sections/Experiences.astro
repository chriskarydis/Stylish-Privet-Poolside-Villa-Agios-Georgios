---
/**
 * "Things to do" — a compact list of experiences, rendered inside the
 * Explore Southern Corfu section (not a section of its own).
 */
import { experiences } from '@content/experiences';
import { home } from '@content/home';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<div id="experiences" class="todo">
  <h3 class="explore__sub" id="experiences-title">{t(home.experiences.title, lang)}</h3>
  <ul role="list" class="exp-grid" aria-labelledby="experiences-title">
    {
      experiences.map((e, i) => (
        <li class="exp" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
          <span class="exp__icon">
            <Icon name={e.icon} size={22} />
          </span>
          <div>
            <h4 class="exp__title">{t(e.title, lang)}</h4>
            <p class="exp__text">{t(e.text, lang)}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .todo {
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
  .exp-grid {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .exp {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.9rem;
  }
  .exp__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--stone);
    border-radius: 50%;
    color: var(--terracotta);
  }
  .exp__title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .exp__text {
    margin-top: 0.2rem;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  @media (min-width: 40em) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .exp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
