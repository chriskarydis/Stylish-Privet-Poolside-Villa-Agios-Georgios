---
/**
 * Rates by season. Renders nothing until rates are configured in
 * src/content/property.ts → rates.seasons (no prices are ever invented).
 */
import { home } from '@content/home';
import { legalPages } from '@content/legal';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { fill, localizePath, t } from '@/i18n/utils';
import { isLinkable } from '@/lib/legal';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { rates, bookingTerms } = property;
const r = home.rates;
const locale = lang === 'el' ? 'el-GR' : 'en-GB';
const money = new Intl.NumberFormat(locale, { style: 'currency', currency: rates.currency, maximumFractionDigits: 0 });
const day = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric' });
const date = (iso: string) => day.format(new Date(`${iso}T12:00:00`));
const nights = (n: number) => (n === 1 ? t(r.night, lang) : fill(t(r.nights, lang), { n }));
// Periods that repeat every year ('MM-DD') are named after their month, so a dates column would only repeat the name.
const yearly = rates.seasons.every((s) => s.from.length === 5);
// A minimum-stay column only when periods differ; one general minimum is a single line under the table.
const showMin = rates.seasons.some((s) => s.minNights);
const terms = legalPages.find((p) => p.slug === 'booking-terms');
const termsHref = terms && isLinkable(terms, lang) ? localizePath(`/${terms.slug}`, lang) : null;
---

{
  rates.seasons.length > 0 && (
    <section id="rates" class="section section--surface" aria-labelledby="rates-title">
      <div class="container rates">
        <div class="section-head">
          <p class="eyebrow">{t(r.eyebrow, lang)}</p>
          <h2 id="rates-title">{t(r.title, lang)}</h2>
        </div>

        <div class="rates__scroll" role="group" aria-labelledby="rates-title" tabindex="0">
          <table class="rates__table">
            <thead>
              <tr>
                <th scope="col">{t(yearly ? r.month : r.season, lang)}</th>
                {!yearly && <th scope="col">{t(r.dates, lang)}</th>}
                <th scope="col" class="num">{t(r.perNight, lang)}</th>
                {showMin && <th scope="col" class="num">{t(r.minStay, lang)}</th>}
              </tr>
            </thead>
            <tbody>
              {rates.seasons.map((s) => (
                <tr>
                  <th scope="row">{t(s.name, lang)}</th>
                  {!yearly && <td>{date(s.from)} – {date(s.to)}</td>}
                  <td class="num rates__price">{money.format(s.perNight)}</td>
                  {showMin && <td class="num">{nights(s.minNights ?? bookingTerms.minNights ?? 1)}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="rates__notes">
          {rates.cleaningFee !== null && <p>{fill(t(r.cleaning, lang), { price: money.format(rates.cleaningFee) })}</p>}
          {!showMin && bookingTerms.minNights && <p>{fill(t(r.minStayNote, lang), { n: bookingTerms.minNights })}</p>}
          {rates.note && <p>{t(rates.note, lang)}</p>}
          {rates.closedNote && <p>{t(rates.closedNote, lang)}</p>}
          <p>{t(r.direct, lang)}</p>
        </div>

        <div class="rates__actions">
          <a class="btn" href="#book">
            {t(r.cta, lang)}
            <Icon name="arrow-right" size={18} />
          </a>
          {termsHref && <a class="text-link" href={termsHref}>{t(terms!.title, lang)}</a>}
        </div>
      </div>
    </section>
  )
}

<style>
  .rates {
    max-width: calc(60rem + var(--gutter) * 2);
  }
  .rates__scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--linen);
  }
  .rates__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.97rem;
  }
  .rates__table th,
  .rates__table td {
    padding: 0.9rem 1.1rem;
    text-align: left;
    white-space: nowrap;
  }
  .rates__table thead th {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .rates__table tbody tr + tr > * {
    border-top: 1px solid var(--line);
  }
  .rates__table tbody th {
    font-weight: 600;
  }
  .rates__table .num {
    text-align: right;
  }
  .rates__price {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--sea);
  }
  .rates__notes {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .rates__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }
</style>
