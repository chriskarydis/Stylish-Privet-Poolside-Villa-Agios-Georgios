---
import { home } from '@content/home';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<div class="split">
  <div class="frame split__media" data-reveal>
    <SmartImage image="bathroom" lang={lang} sizes="(min-width: 64em) 45vw, 92vw" />
  </div>
  <div class="split__text">
    <span class="split__icon"><Icon name="shower-head" size={26} /></span>
    <h3>{t(home.bathrooms.title, lang)}</h3>
    <p class="lead">{t(home.bathrooms.body, lang)}</p>
  </div>
</div>

<style>
  .split {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .split__media {
    aspect-ratio: 3 / 2;
  }
  .split__text {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }
  .split__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--sea-tint);
    color: var(--sea);
  }
  @media (min-width: 64em) {
    .split {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(3rem, 1rem + 5vw, 6rem);
    }
  }
</style>
