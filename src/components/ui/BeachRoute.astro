---
/**
 * Illustrated walk from the villa to the beach: two markers joined by a
 * path, with a dot walking along it. Purely schematic — not a map.
 * The walking time is shown only when confirmed (property.facts.beachWalkMinutes);
 * the distance itself is shown once, on the photo badge above (LocationSection).
 */
import { home } from '@content/home';
import { property } from '@content/property';
import type { Locale } from '@/i18n/config';
import { fill, t } from '@/i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const r = home.location.route;
const { beachWalkMinutes } = property.facts;
const walk = beachWalkMinutes ? fill(t(r.walkTime, lang), { n: beachWalkMinutes }) : t(r.walkGeneric, lang);
// The same curve is drawn as the dashed path and followed by the walking dot.
const PATH = 'M50 62 C 105 18, 150 104, 200 62 S 296 22, 350 60';
---

<figure class="route" data-reveal>
  <figcaption class="route__title">{t(r.title, lang)}</figcaption>

  <svg class="route__art" viewBox="0 0 400 120" aria-hidden="true" focusable="false">
    <!-- sea on the beach side -->
    <g class="route__sea" fill="none" stroke-linecap="round">
      <path d="M318 96c7-5 14-5 21 0s14 5 21 0 14-5 21 0 14 5 21 0" />
      <path d="M330 108c7-5 14-5 21 0s14 5 21 0 14-5 21 0" />
    </g>
    <!-- a few trees along the way -->
    <g class="route__trees">
      <path d="M118 96c-5-16-3-30 3-40 6 10 8 24 3 40z" />
      <path d="M238 100c-4-13-2-24 3-32 5 8 7 19 3 32z" />
      <circle cx="170" cy="30" r="9" />
      <rect x="169" y="36" width="2" height="12" />
    </g>

    <path class="route__path" d={PATH} fill="none" />
    <circle class="route__walker" r="5.5" style={`offset-path: path('${PATH}')`} />

    <!-- villa marker -->
    <g class="route__marker">
      <circle cx="30" cy="62" r="20" />
      <g transform="translate(18 50)" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
        <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
      </g>
    </g>
    <!-- beach marker -->
    <g class="route__marker route__marker--beach">
      <circle cx="370" cy="60" r="20" />
      <g transform="translate(358 48)" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
        <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
        <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
      </g>
    </g>
  </svg>

  <div class="route__labels">
    <span class="route__place">{t(r.villa, lang)}</span>
    <span class="route__info">
      <strong>{walk}</strong>
    </span>
    <span class="route__place route__place--end">{t(r.beach, lang)}</span>
  </div>
</figure>

<script>
  // Pause the walking dot whenever the graphic is off screen.
  const routes = document.querySelectorAll('.route');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('is-inview', entry.isIntersecting);
    });
    routes.forEach((route) => io.observe(route));
  } else {
    routes.forEach((route) => route.classList.add('is-inview'));
  }
</script>

<style>
  .route {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: clamp(1.25rem, 0.9rem + 1.5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--linen);
  }
  .route__title {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }
  .route__art {
    width: 100%;
    max-width: 44rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  .route__path {
    stroke: var(--stone);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1 7;
  }
  .route__sea {
    stroke: var(--sea);
    stroke-width: 1.5;
    opacity: 0.35;
  }
  .route__trees {
    fill: var(--olive);
    opacity: 0.3;
  }
  .route__marker circle {
    fill: var(--surface);
    stroke: var(--sea);
    stroke-width: 1.5;
  }
  .route__marker g {
    stroke: var(--sea);
    stroke-width: 1.5;
  }
  .route__marker--beach circle {
    fill: var(--sea);
  }
  .route__marker--beach g {
    stroke: var(--on-dark);
  }
  .route__walker {
    fill: var(--terracotta);
    offset-rotate: 0deg;
    offset-distance: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .route__walker {
      animation: route-walk 7s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }
    /* With JavaScript the dot walks only while the graphic is on screen (see the script below). */
    :global(.js) .route:not(.is-inview) .route__walker {
      animation-play-state: paused;
    }
  }
  /* Walk to the beach, pause there, then start again from the villa. */
  @keyframes route-walk {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    78% {
      offset-distance: 100%;
      opacity: 1;
    }
    92%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  .route__labels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 0.75rem;
    max-width: 44rem;
    width: 100%;
    margin-inline: auto;
    font-size: var(--fs-sm);
    line-height: 1.35;
  }
  .route__place {
    font-weight: 600;
  }
  .route__place--end {
    text-align: right;
  }
  .route__info {
    display: grid;
    justify-items: center;
    text-align: center;
    color: var(--ink-soft);
  }
  .route__info strong {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--sea);
  }
</style>
