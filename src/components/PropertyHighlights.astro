---
import { highlights } from '@content/amenities';
import { home } from '@content/home';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import Icon from './ui/Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<section class="highlights" aria-labelledby="highlights-title">
  <div class="container">
    <h2 id="highlights-title" class="visually-hidden">{t(home.highlights.title, lang)}</h2>
    <ul role="list" class="highlights__list">
      {
        highlights.map((h, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <Icon name={h.icon} size={26} />
            <span>{t(h.label, lang)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .highlights__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
  }
  .highlights__list li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1.4rem 0.75rem 1.4rem 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .highlights__list li:nth-child(n + 3) {
    border-top: 1px solid var(--line);
  }
  .highlights__list :global(.icon) {
    color: var(--sea);
  }
  @media (min-width: 40em) {
    .highlights__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .highlights__list li:nth-child(n + 3) {
      border-top: 0;
    }
    .highlights__list li:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
  @media (min-width: 64em) {
    .highlights__list {
      grid-template-columns: repeat(6, 1fr);
    }
    .highlights__list li {
      padding: 2rem 1.25rem;
      border-left: 1px solid var(--line);
    }
    .highlights__list li:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .highlights__list li:nth-child(n + 4) {
      border-top: 0;
    }
  }
</style>
