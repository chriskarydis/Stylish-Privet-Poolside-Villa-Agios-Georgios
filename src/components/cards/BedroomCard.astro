---
import type { ImageKey } from '@content/gallery';
import type { Locale, Localized } from '@/i18n/config';
import { t } from '@/i18n/utils';
import SmartImage from '@/components/ui/SmartImage.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

interface Props {
  lang: Locale;
  room: Localized;
  beds: Localized;
  icon: IconName;
  image: ImageKey;
  index: number;
}
const { lang, room, beds, icon, image, index } = Astro.props;
---

<article class="bed-card" data-reveal style={`--reveal-delay:${index * 90}ms`}>
  <div class="frame bed-card__media">
    <SmartImage image={image} lang={lang} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 92vw" />
  </div>
  <div class="bed-card__body">
    <span class="bed-card__num serif" aria-hidden="true">0{index + 1}</span>
    <div>
      <h3 class="bed-card__title">{t(room, lang)}</h3>
      <p class="bed-card__beds">
        <Icon name={icon} size={20} />
        {t(beds, lang)}
      </p>
    </div>
  </div>
</article>

<style>
  .bed-card {
    display: grid;
    gap: 1.1rem;
  }
  .bed-card__media {
    aspect-ratio: 4 / 3;
  }
  .bed-card__body {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .bed-card__num {
    font-size: 1.1rem;
    color: var(--terracotta);
  }
  .bed-card__title {
    font-size: var(--fs-h4);
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .bed-card__beds {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .bed-card__beds :global(.icon) {
    color: var(--sea);
  }
</style>
