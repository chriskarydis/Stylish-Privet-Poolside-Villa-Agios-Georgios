---
/**
 * Availability calendar + booking options.
 * - Booked dates come from /api/availability (Cloudflare function reading the
 *   Airbnb / Booking.com iCal feeds). Without it, dates can still be chosen.
 * - Sends guests to Airbnb / Booking.com with dates and guests prefilled, or
 *   lets them send a booking request (Formspree / email) or a WhatsApp message.
 */
import { home } from '@content/home';
import { property } from '@content/property';
import { legalPages } from '@content/legal';
import type { Locale } from '@/i18n/config';
import { fill, localizePath, t } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';
import { isLinkable } from '@/lib/legal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const w = home.booking.widget;
const f = home.forms;
const max = property.facts.maxGuests;
const privacyHref = localizePath(`/${legalPages.find((p) => p.slug === 'privacy-policy')!.slug}`, lang);
const [privacyBefore, privacyAfter] = t(f.privacy, lang).split('{link}');
const bookingTermsPage = legalPages.find((p) => p.slug === 'booking-terms');
const termsHref = bookingTermsPage && isLinkable(bookingTermsPage, lang) ? localizePath(`/${bookingTermsPage.slug}`, lang) : null;

// Everything the browser script needs, already in the page language.
const config = {
  locale: lang === 'el' ? 'el-GR' : 'en-GB',
  maxGuests: max,
  monthsAhead: property.availability.monthsAhead,
  endpoint: property.availability.endpoint,
  airbnb: property.booking.airbnb[lang],
  bookingCom: property.booking.bookingCom[lang],
  whatsapp: property.contact.whatsapp,
  email: property.contact.email,
  formId: property.forms.bookingFormId,
  seasons: property.rates.seasons.map(({ from, to, perNight, minNights }) => ({ from, to, perNight, minNights })),
  cleaningFee: property.rates.cleaningFee,
  closedNote: property.rates.closedNote ? t(property.rates.closedNote, lang) : null,
  currency: property.rates.currency,
  minNights: property.bookingTerms.minNights,
  checkInTime: property.rules.checkIn,
  checkOutTime: property.rules.checkOut,
  s: {
    ...Object.fromEntries(
      Object.entries({ ...w, ...f })
        .filter(([k]) => k !== 'owner')
        .map(([k, v]) => [k, t(v as { en: string; el: string }, lang)]),
    ),
    whatsappGeneral: t(home.contact.whatsappMessage, lang),
  } as Record<string, string>,
  owner: f.owner,
};
---

<div class="bw" data-booking-widget>
  <script type="application/json" data-bw-config set:html={JSON.stringify(config)} />

  <div class="bw__head">
    <h3 class="bw__title" id="bw-title">{t(home.booking.cta, lang)}</h3>
    <button type="button" class="bw__clear" data-bw-clear hidden>{t(w.clear, lang)}</button>
  </div>

  <p class="bw__step"><span aria-hidden="true">1</span>{t(w.stepDates, lang)}</p>

  <div class="bw__dates" aria-hidden="true">
    <div class="bw__date" data-bw-in-box>
      <span class="bw__date-label">{t(w.checkIn, lang)}</span>
      <span class="bw__date-value" data-bw-in>{t(w.selectDate, lang)}</span>
    </div>
    <span class="bw__arrow"><Icon name="arrow-right" size={18} /></span>
    <div class="bw__date" data-bw-out-box>
      <span class="bw__date-label">{t(w.checkOut, lang)}</span>
      <span class="bw__date-value" data-bw-out>{t(w.selectDate, lang)}</span>
    </div>
  </div>

  <div class="bw__cal" role="group" aria-labelledby="bw-title">
    <div class="bw__nav">
      <button type="button" class="bw__nav-btn" data-bw-prev>
        <Icon name="chevron-left" size={20} />
        <span class="visually-hidden">{t(w.prevMonth, lang)}</span>
      </button>
      <button type="button" class="bw__nav-btn" data-bw-next>
        <Icon name="chevron-right" size={20} />
        <span class="visually-hidden">{t(w.nextMonth, lang)}</span>
      </button>
    </div>
    <div class="bw__months" data-bw-months>
      <noscript><p class="bw__noscript">{t(w.notSynced, lang)}</p></noscript>
    </div>
    <ul class="bw__legend" role="list">
      <li data-bw-legend-free hidden><span class="bw__swatch bw__swatch--free"></span>{t(w.legendAvailable, lang)}</li>
      <li data-bw-legend-booked hidden><span class="bw__swatch bw__swatch--booked"></span>{t(w.legendBooked, lang)}</li>
      <li><span class="bw__swatch bw__swatch--sel"></span>{t(w.legendSelected, lang)}</li>
    </ul>
  </div>

  <p class="bw__status" data-bw-status aria-live="polite">{t(w.pickCheckIn, lang)}</p>
  <p class="bw__warn" data-bw-warn role="status" hidden>
    <Icon name="info" size={18} />
    <span>{t(w.unknown, lang)}</span>
  </p>
  <p class="bw__note" data-bw-note>{t(w.notSynced, lang)}</p>

  <fieldset class="bw__guests">
    <legend class="bw__step"><span aria-hidden="true">2</span>{t(w.guests, lang)}</legend>
    <div class="bw__guest-row">
      <label>
        <span>{t(w.adults, lang)}</span>
        <select data-bw-adults>
          {Array.from({ length: max }, (_, i) => <option value={i + 1} selected={i === 1}>{i + 1}</option>)}
        </select>
      </label>
      <label>
        <span>{t(w.children, lang)}</span>
        <select data-bw-children>
          {Array.from({ length: max }, (_, i) => <option value={i}>{i}</option>)}
        </select>
      </label>
    </div>
    <div class="bw__ages" data-bw-ages></div>
    <p class="bw__hint">{fill(t(w.maxGuests, lang), { n: max })}</p>
  </fieldset>

  <p class="bw__summary" data-bw-summary aria-live="polite" hidden></p>
  <p class="bw__price" data-bw-price aria-live="polite" hidden></p>

  <p class="bw__step"><span aria-hidden="true">3</span>{t(w.stepBook, lang)}</p>

  <!-- Direct booking first (primary), platforms second (secondary). -->
  <div class="bw__group">
    <p class="bw__group-title">{t(w.bookDirect, lang)}</p>
    <div class="bw__pair">
      <button type="button" class="btn" data-bw-request aria-expanded="false" aria-controls="bw-form">
        <Icon name="mail" size={18} />
        {t(w.request, lang)}
      </button>
      {
        property.contact.whatsapp && (
          <a class="btn" data-bw-whatsapp href={`https://wa.me/${property.contact.whatsapp}`} target="_blank" rel="noopener noreferrer">
            <Icon name="message-circle" size={18} />
            {t(w.whatsapp, lang)}
            <span class="visually-hidden"> {t(ui.opensInNewTab, lang)}</span>
          </a>
        )
      }
    </div>
  </div>

  <form class="bw__form" id="bw-form" data-bw-form hidden novalidate>
    <p class="bw__form-stay" data-bw-form-stay></p>
    <div class="field">
      <label for="bw-name">{t(f.name, lang)} <span aria-hidden="true">*</span></label>
      <input id="bw-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="bw-email">{t(f.email, lang)} <span aria-hidden="true">*</span></label>
      <input id="bw-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="bw-phone">{t(f.phone, lang)}</label>
      <input id="bw-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div class="field">
      <label for="bw-message">{t(f.messageOptional, lang)}</label>
      <textarea id="bw-message" name="message" rows="3"></textarea>
    </div>
    <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="bw__fine">
      {t(f.requestNote, lang)}
      {termsHref && <> <a href={termsHref}>{t(w.termsLink, lang)}</a>.</>}
    </p>
    <p class="bw__fine">{privacyBefore}<a href={privacyHref}>{t(f.privacyLink, lang)}</a>{privacyAfter}</p>
    {!property.forms.bookingFormId && <p class="bw__fine">{t(f.mailFallback, lang)}</p>}
    <button type="submit" class="btn" data-bw-submit>{t(f.sendRequest, lang)}</button>
    <p class="form-result" data-bw-result role="status" hidden></p>
  </form>

  <div class="bw__group bw__group--platforms">
    <p class="bw__group-title">{t(w.orPlatforms, lang)}</p>
    <div class="bw__pair">
      <a class="btn btn--outline" data-bw-airbnb href={property.booking.airbnb[lang]} target="_blank" rel="noopener noreferrer">
        {fill(t(w.continueOn, lang), { platform: 'Airbnb' })}
        <span class="visually-hidden"> {t(ui.opensInNewTab, lang)}</span>
        <Icon name="external-link" size={16} />
      </a>
      <a class="btn btn--outline" data-bw-booking href={property.booking.bookingCom[lang]} target="_blank" rel="noopener noreferrer">
        {fill(t(w.continueOn, lang), { platform: 'Booking.com' })}
        <span class="visually-hidden"> {t(ui.opensInNewTab, lang)}</span>
        <Icon name="external-link" size={16} />
      </a>
    </div>
  </div>
</div>

<script>
  import {
    addDays,
    airbnbLink,
    blockedNights,
    bookingComLink,
    estimatePrice,
    fromIso,
    minNightsFor,
    nightsBetween,
    toIso,
    type AvailabilityResponse,
    type AvailabilityStatus,
    type IsoDate,
    type PriceSeason,
  } from '@/lib/availability';
  import { formValues, isSpam, markInvalid, sendForm, setBusy, showFormResult } from '@/lib/forms';

  type Config = {
    locale: string;
    maxGuests: number;
    monthsAhead: number;
    endpoint: string;
    airbnb: string;
    bookingCom: string;
    whatsapp: string | null;
    email: string | null;
    formId: string | null;
    seasons: PriceSeason[];
    cleaningFee: number | null;
    closedNote: string | null;
    currency: string;
    minNights: number | null;
    checkInTime: string;
    checkOutTime: string;
    s: Record<string, string>;
    owner: Record<string, string> & { languages: Record<string, string> };
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-booking-widget]')) initWidget(root);

  function initWidget(root: HTMLElement) {
    const cfg = JSON.parse(root.querySelector('[data-bw-config]')!.textContent!) as Config;
    const s = cfg.s;
    const fmt = (tpl: string, v: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const monthsEl = $('[data-bw-months]');
    const statusEl = $('[data-bw-status]');
    const summaryEl = $('[data-bw-summary]');
    const inEl = $('[data-bw-in]');
    const outEl = $('[data-bw-out]');
    const clearBtn = $<HTMLButtonElement>('[data-bw-clear]');
    const priceEl = $('[data-bw-price]');
    let priceText = '';
    const adultsSel = $<HTMLSelectElement>('[data-bw-adults]');
    const childrenSel = $<HTMLSelectElement>('[data-bw-children]');
    const agesEl = $('[data-bw-ages]');
    const airbnbA = $<HTMLAnchorElement>('[data-bw-airbnb]');
    const bookingA = $<HTMLAnchorElement>('[data-bw-booking]');
    const waA = root.querySelector<HTMLAnchorElement>('[data-bw-whatsapp]');
    const requestBtn = $<HTMLButtonElement>('[data-bw-request]');
    const form = $<HTMLFormElement>('[data-bw-form]');

    const today = toIso(new Date());
    const lastDay = (() => {
      const d = new Date();
      d.setMonth(d.getMonth() + cfg.monthsAhead);
      return toIso(d);
    })();

    let blocked = new Set<IsoDate>();
    let status: AvailabilityStatus = 'unconfigured';
    let checkIn: IsoDate | null = null;
    let checkOut: IsoDate | null = null;
    let hover: IsoDate | null = null;
    let focusDate: IsoDate = today;
    let view = new Date(new Date().getFullYear(), new Date().getMonth(), 1);

    const dfLong = new Intl.DateTimeFormat(cfg.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const dfShort = new Intl.DateTimeFormat(cfg.locale, { weekday: 'short', day: 'numeric', month: 'short' });
    const dfMonth = new Intl.DateTimeFormat(cfg.locale, { month: 'long', year: 'numeric' });
    const dfWeekday = new Intl.DateTimeFormat(cfg.locale, { weekday: 'short' });
    const dfWeekdayLong = new Intl.DateTimeFormat(cfg.locale, { weekday: 'long' });
    const cap = (x: string) => x.charAt(0).toLocaleUpperCase(cfg.locale) + x.slice(1);

    // ---------- Rules ----------
    /** Last date that may be chosen as check-out for the current check-in (the first booked night after it). */
    const checkoutLimit = (from: IsoDate): IsoDate => {
      for (let d = addDays(from, 1); d <= lastDay; d = addDays(d, 1)) if (blocked.has(d)) return d;
      return lastDay;
    };
    const selectingOut = () => !!checkIn && !checkOut;
    const canStart = (d: IsoDate) => d >= today && d < lastDay && !blocked.has(d);
    const minStay = (from: IsoDate) => minNightsFor(from, cfg.seasons, cfg.minNights);
    const canEnd = (d: IsoDate) => !!checkIn && d >= addDays(checkIn, minStay(checkIn)) && d <= checkoutLimit(checkIn);
    const money = new Intl.NumberFormat(cfg.locale, { style: 'currency', currency: cfg.currency, maximumFractionDigits: 0 });
    // While choosing check-out: later days are selectable only as a valid check-out
    // (so days inside the minimum stay are disabled); earlier days, or days beyond the
    // next booking, start a new selection.
    const selectable = (d: IsoDate) =>
      selectingOut() ? canEnd(d) || (canStart(d) && (d <= checkIn! || d > checkoutLimit(checkIn!))) : canStart(d);

    // ---------- Rendering ----------
    function render() {
      const focused = monthsEl.contains(document.activeElement);
      monthsEl.replaceChildren();
      for (let m = 0; m < 2; m++) {
        const first = new Date(view.getFullYear(), view.getMonth() + m, 1);
        const wrap = document.createElement('div');
        wrap.className = 'bw__month';
        const titleId = `bw-m-${first.getFullYear()}-${first.getMonth()}`;
        const h = document.createElement('h4');
        h.id = titleId;
        h.className = 'bw__month-title';
        h.textContent = cap(dfMonth.format(first));
        const table = document.createElement('table');
        table.setAttribute('role', 'grid');
        table.setAttribute('aria-labelledby', titleId);
        const thead = table.createTHead().insertRow();
        const monday = new Date(2024, 0, 1); // a Monday
        for (let i = 0; i < 7; i++) {
          const d = new Date(monday);
          d.setDate(1 + i);
          const th = document.createElement('th');
          th.scope = 'col';
          th.abbr = dfWeekdayLong.format(d);
          th.textContent = dfWeekday.format(d).slice(0, 2);
          thead.append(th);
        }
        const body = table.createTBody();
        const offset = (first.getDay() + 6) % 7; // Monday-first
        const days = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();
        let row = body.insertRow();
        for (let i = 0; i < offset; i++) row.insertCell();
        for (let day = 1; day <= days; day++) {
          if (row.cells.length === 7) row = body.insertRow();
          const iso = toIso(new Date(first.getFullYear(), first.getMonth(), day));
          const cell = row.insertCell();
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'bw__day';
          b.dataset.date = iso;
          b.textContent = String(day);
          cell.append(b);
        }
        while (row.cells.length < 7) row.insertCell();
        wrap.append(h, table);
        monthsEl.append(wrap);
      }
      paint();
      if (focused) monthsEl.querySelector<HTMLButtonElement>(`[data-date="${focusDate}"]`)?.focus();
    }

    function paint() {
      const end = checkOut ?? (selectingOut() && hover && canEnd(hover) ? hover : null);
      const buttons = monthsEl.querySelectorAll<HTMLButtonElement>('.bw__day');
      const visible = [...buttons].map((b) => b.dataset.date!);
      if (!visible.includes(focusDate)) focusDate = visible.find((d) => selectable(d)) ?? visible[0];
      for (const b of buttons) {
        const d = b.dataset.date!;
        const past = d < today || d >= lastDay;
        const booked = blocked.has(d);
        const ok = !past && selectable(d);
        const checkoutOnly = booked && selectingOut() && canEnd(d);
        b.classList.toggle('is-past', past);
        b.classList.toggle('is-booked', booked && !past && !checkoutOnly);
        b.classList.toggle('is-today', d === today);
        b.classList.toggle('is-start', d === checkIn);
        b.classList.toggle('is-end', d === end);
        b.classList.toggle('is-range', !!checkIn && !!end && d > checkIn && d < end);
        b.setAttribute('aria-disabled', String(!ok));
        b.setAttribute('aria-pressed', String(d === checkIn || d === checkOut));
        b.tabIndex = d === focusDate ? 0 : -1;
        // Never call a day "available" unless every calendar was read successfully.
        const state = past ? '' : checkoutOnly ? s.dayCheckoutOnly : booked ? s.dayBooked : status === 'ok' ? s.dayAvailable : '';
        const role = d === checkIn ? `, ${s.checkIn}` : d === checkOut ? `, ${s.checkOut}` : '';
        b.setAttribute('aria-label', `${dfLong.format(fromIso(d))}${state ? `, ${state}` : ''}${role}`);
      }
      const prev = root.querySelector<HTMLButtonElement>('[data-bw-prev]')!;
      const next = root.querySelector<HTMLButtonElement>('[data-bw-next]')!;
      const now = new Date();
      prev.disabled = view.getFullYear() === now.getFullYear() && view.getMonth() === now.getMonth();
      next.disabled = toIso(new Date(view.getFullYear(), view.getMonth() + 1, 1)) >= lastDay.slice(0, 8) + '01';
      update();
    }

    // ---------- Summary, links, messages ----------
    const guests = () => ({
      adults: Number(adultsSel.value),
      childAges: [...agesEl.querySelectorAll<HTMLSelectElement>('select')].map((x) => Number(x.value)),
    });
    const guestsText = () => {
      const g = guests();
      const a = g.adults === 1 ? s.guestsSummaryAdult : fmt(s.guestsSummaryAdults, { n: g.adults });
      const c = g.childAges.length === 0 ? '' : g.childAges.length === 1 ? s.guestsSummaryChild : fmt(s.guestsSummaryChildren, { n: g.childAges.length });
      return c ? `${a}, ${c}` : a;
    };
    const nightsText = () => {
      const n = checkIn && checkOut ? nightsBetween(checkIn, checkOut) : 0;
      return n === 1 ? s.night : fmt(s.nights, { n });
    };

    function update() {
      inEl.textContent = checkIn ? dfShort.format(fromIso(checkIn)) : s.selectDate;
      outEl.textContent = checkOut ? dfShort.format(fromIso(checkOut)) : s.selectDate;
      $('[data-bw-in-box]').classList.toggle('is-active', !checkIn);
      $('[data-bw-out-box]').classList.toggle('is-active', selectingOut());
      clearBtn.hidden = !checkIn;
      const complete = !!(checkIn && checkOut);
      summaryEl.hidden = !complete;
      if (complete) {
        summaryEl.textContent = `${dfShort.format(fromIso(checkIn!))} (${cfg.checkInTime}) → ${dfShort.format(fromIso(checkOut!))} (${cfg.checkOutTime}) · ${nightsText()} · ${guestsText()}`;
      }
      const price = complete ? estimatePrice(checkIn!, checkOut!, cfg.seasons, cfg.cleaningFee) : null;
      priceText = !complete || !cfg.seasons.length ? '' : price
        ? `${fmt(s.estimate, { price: money.format(price.total) })}${price.cleaning ? ` (${fmt(s.inclCleaning, { price: money.format(price.cleaning) })})` : ''}. ${s.estimateNote}`
        : (cfg.closedNote ?? s.priceOnRequest);
      priceEl.textContent = priceText;
      priceEl.hidden = !priceText;
      const g = guests();
      airbnbA.href = airbnbLink(cfg.airbnb, checkIn && checkOut ? checkIn : null, checkOut, g);
      bookingA.href = bookingComLink(cfg.bookingCom, checkIn && checkOut ? checkIn : null, checkOut, g);
      if (waA && cfg.whatsapp) {
        const text = complete
          ? fmt(s.whatsappMessage, { in: dfShort.format(fromIso(checkIn!)), out: dfShort.format(fromIso(checkOut!)), nights: nightsText(), guests: guestsText() })
          : s.whatsappGeneral;
        waA.href = `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(text)}`;
      }
      const stay = root.querySelector('[data-bw-form-stay]');
      if (stay) stay.textContent = complete ? `${s.stay}: ${summaryEl.textContent}` : '';
    }

    // ---------- Interaction ----------
    function choose(d: IsoDate) {
      if (!selectable(d)) return;
      if (selectingOut() && canEnd(d)) {
        checkOut = d;
      } else {
        checkIn = d;
        checkOut = null;
      }
      focusDate = d;
      paint();
      setStatus();
    }
    /** Instruction line: what to do next (or nothing once both dates are chosen). */
    const setStatus = (text?: string) => {
      const min = checkIn ? minStay(checkIn) : 1;
      const pickOut = min > 1 ? `${s.pickCheckOut} ${fmt(s.minStay, { n: min })}` : s.pickCheckOut;
      statusEl.textContent = text ?? (selectingOut() ? pickOut : checkIn && checkOut ? '' : s.pickCheckIn);
    };

    monthsEl.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.bw__day');
      if (b) choose(b.dataset.date!);
    });
    monthsEl.addEventListener('mouseover', (e) => {
      const d = (e.target as Element).closest<HTMLButtonElement>('.bw__day')?.dataset.date ?? null;
      if (d !== hover && selectingOut()) {
        hover = d;
        paint();
      }
    });
    monthsEl.addEventListener('mouseleave', () => {
      if (hover) {
        hover = null;
        paint();
      }
    });
    monthsEl.addEventListener('keydown', (e) => {
      const steps: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 };
      let target: IsoDate | null = null;
      if (e.key in steps) target = addDays(focusDate, steps[e.key]);
      else if (e.key === 'PageUp') target = addDays(focusDate, -28);
      else if (e.key === 'PageDown') target = addDays(focusDate, 28);
      if (!target) return;
      e.preventDefault();
      if (target < today) target = today;
      if (target >= lastDay) target = addDays(lastDay, -1);
      focusDate = target;
      const t = fromIso(target);
      const firstShown = view;
      const lastShown = new Date(view.getFullYear(), view.getMonth() + 2, 0);
      if (t < firstShown) view = new Date(t.getFullYear(), t.getMonth(), 1);
      else if (t > lastShown) view = new Date(t.getFullYear(), t.getMonth() - 1, 1);
      if (selectingOut()) hover = target;
      render();
      monthsEl.querySelector<HTMLButtonElement>(`[data-date="${focusDate}"]`)?.focus();
    });
    root.querySelector('[data-bw-prev]')!.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      render();
    });
    root.querySelector('[data-bw-next]')!.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      render();
    });
    clearBtn.addEventListener('click', () => {
      checkIn = checkOut = hover = null;
      paint();
      setStatus();
      monthsEl.querySelector<HTMLButtonElement>('[tabindex="0"]')?.focus();
    });

    // Guests
    function syncGuests() {
      const adults = Number(adultsSel.value);
      const maxChildren = cfg.maxGuests - adults;
      for (const o of childrenSel.options) o.disabled = Number(o.value) > maxChildren;
      if (Number(childrenSel.value) > maxChildren) childrenSel.value = String(maxChildren);
      const n = Number(childrenSel.value);
      const existing = [...agesEl.querySelectorAll('label')];
      existing.slice(n).forEach((l) => l.remove());
      for (let i = existing.length; i < n; i++) {
        const label = document.createElement('label');
        const span = document.createElement('span');
        span.textContent = fmt(s.childAge, { n: i + 1 });
        const sel = document.createElement('select');
        for (let age = 0; age <= 17; age++) {
          const o = document.createElement('option');
          o.value = String(age);
          o.textContent = age === 0 ? s.under1 : age === 1 ? s.year1 : fmt(s.years, { n: age });
          if (age === 8) o.selected = true;
          sel.append(o);
        }
        sel.addEventListener('change', update);
        label.append(span, sel);
        agesEl.append(label);
      }
      update();
    }
    adultsSel.addEventListener('change', syncGuests);
    childrenSel.addEventListener('change', syncGuests);

    // Direct booking request
    requestBtn.addEventListener('click', () => {
      if (!checkIn || !checkOut) {
        statusEl.textContent = s.needDates;
        monthsEl.querySelector<HTMLButtonElement>('[tabindex="0"]')?.focus();
        return;
      }
      form.hidden = !form.hidden;
      requestBtn.setAttribute('aria-expanded', String(!form.hidden));
      if (!form.hidden) form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const result = form.querySelector<HTMLElement>('[data-bw-result]')!;
      const submit = form.querySelector<HTMLButtonElement>('[data-bw-submit]')!;
      if (submit.getAttribute('aria-disabled') === 'true') return; // already sending
      result.hidden = true;
      markInvalid(form);
      if (!checkIn || !checkOut) {
        showResult(result, s.needDates, false);
        return;
      }
      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector<HTMLInputElement>(':invalid');
        showResult(result, firstInvalid?.type === 'email' && firstInvalid.value ? s.invalidEmail : s.fillRequired, false);
        firstInvalid?.focus();
        return;
      }
      if (isSpam(form)) return;
      const v = formValues(form);
      const g = guests();
      setBusy(submit, true);
      submit.textContent = s.sending;
      const o = cfg.owner;
      const ownerDate = new Intl.DateTimeFormat(o.locale, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
      const total = g.adults + g.childAges.length;
      const totalText = total === 1 ? o.guestsOne : o.guestsMany.replace('{n}', String(total));
      const ages = g.childAges.map((age) => (age === 0 ? o.under1 : String(age))).join(', ');
      const res = await sendForm({
        formId: cfg.formId,
        fallbackEmail: cfg.email,
        subject: fmt(o.subjectBooking, { in: ownerDate.format(fromIso(checkIn)), out: ownerDate.format(fromIso(checkOut)), guests: totalText, name: v.name }),
        // Order and labels are what the owner reads in the email.
        data: {
          [o.checkIn]: `${ownerDate.format(fromIso(checkIn))} (${checkIn})`,
          [o.checkOut]: `${ownerDate.format(fromIso(checkOut))} (${checkOut})`,
          [o.nights]: String(nightsBetween(checkIn, checkOut)),
          [o.adults]: String(g.adults),
          [o.children]: g.childAges.length ? fmt(o.childrenAges, { n: g.childAges.length, ages }) : '0',
          [o.totalGuests]: String(total),
          [o.name]: v.name,
          email: v.email,
          [o.phone]: v.phone,
          [o.message]: v.message,
          [o.estimate]: priceText,
          [o.language]: o.languages[document.documentElement.lang] ?? document.documentElement.lang,
        },
      });
      setBusy(submit, false);
      submit.textContent = s.sendRequest;
      if (res === 'sent') {
        form.reset();
        showResult(result, s.requestSuccess, true);
      } else if (res === 'error') showResult(result, s.error, false);
    });
    function showResult(el: HTMLElement, text: string, ok: boolean) {
      showFormResult(el, text, ok);
    }

    // ---------- Availability ----------
    const noteEl = $('[data-bw-note]');
    let loaded = false;
    async function loadAvailability() {
      if (loaded) return;
      loaded = true;
      noteEl.textContent = s.loading;
      try {
        const res = await fetch(cfg.endpoint, { headers: { Accept: 'application/json' } });
        if (res.status === 404) {
          status = 'unconfigured'; // the function is not deployed (e.g. local development)
        } else if (!res.ok) {
          status = 'unavailable';
        } else {
          const data = (await res.json()) as AvailabilityResponse;
          const known: AvailabilityStatus[] = ['ok', 'partial', 'unavailable', 'unconfigured'];
          // An answer in the pre-status format may still be cached for a few minutes after a
          // deploy: "configured: false" meant no calendars; anything else unknown is unsafe.
          const legacyUnconfigured = (data as { configured?: boolean }).configured === false;
          status = known.includes(data.status) ? data.status : legacyUnconfigured ? 'unconfigured' : 'unavailable';
          blocked = blockedNights(Array.isArray(data.blocked) ? data.blocked : []);
        }
      } catch {
        status = 'unavailable'; // network error or an unreadable answer — never treated as "all free"
      }
      // 'ok'           → booked and available days are both known
      // 'partial'      → known bookings are shown, nothing is called available, warning shown
      // 'unavailable'  → nothing is known, warning shown
      // 'unconfigured' → no calendars connected: plain date picker, no availability claims
      const unsure = status === 'partial' || status === 'unavailable';
      $('[data-bw-warn]').hidden = !unsure;
      $('[data-bw-legend-free]').hidden = status !== 'ok';
      $('[data-bw-legend-booked]').hidden = blocked.size === 0;
      noteEl.textContent = status === 'ok' ? s.synced : s.notSynced;
      noteEl.hidden = unsure; // the warning already says what to do
      root.dataset.availability = status;
      // Drop a selection that turned out to overlap a booking.
      if (checkIn && blocked.has(checkIn)) checkIn = checkOut = null;
      if (checkIn && checkOut && !canEnd(checkOut)) checkOut = null;
      paint();
      setStatus();
    }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          loadAvailability();
        }
      }, { rootMargin: '600px 0px' });
      io.observe(root);
    } else loadAvailability();
    root.addEventListener('pointerdown', loadAvailability, { once: true });
    root.addEventListener('focusin', loadAvailability, { once: true });

    render();
    syncGuests();
  }
</script>

